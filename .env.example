# ── Project ────────────────────────────────────────────────
PROJECT_NAME="Lemon"
PROJECT_DESCRIPTION="Lemon – Developer Intelligence API"
VERSION="0.1.0"

# ── Server ─────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── API ────────────────────────────────────────────────────
API_V1_STR=/api/v1

# ── CORS ───────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]
ALLOWED_METHODS=["*"]
ALLOWED_HEADERS=["*"]

# ── AWS ────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=375243950000
# Leave blank to use IAM role / instance profile on EC2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Local DynamoDB (leave blank in production)
# AWS_ENDPOINT_URL=http://localhost:8000

# ── DynamoDB (your account – us-east-1) ───────────────────
DYNAMO_TABLE_PREFIX=lemon
# Table ARNs (deployed via LemonDynamoStack)
# SimUsers:             arn:aws:dynamodb:us-east-1:375243950000:table/SimUsers
# SimEvents:            arn:aws:dynamodb:us-east-1:375243950000:table/SimEvents
# UserSprintFacts:      arn:aws:dynamodb:us-east-1:375243950000:table/UserSprintFacts
# UserSprintContext:    arn:aws:dynamodb:us-east-1:375243950000:table/UserSprintContext
# Projects:             arn:aws:dynamodb:us-east-1:375243950000:table/Projects
# ProjectMappings:      arn:aws:dynamodb:us-east-1:375243950000:table/ProjectMappings
# ProjectFacts:         arn:aws:dynamodb:us-east-1:375243950000:table/ProjectFacts
# ProjectSprintContext: arn:aws:dynamodb:us-east-1:375243950000:table/ProjectSprintContext

# ── DynamoDB (friend's account – cross-account) ────────────
# Fill in once your friend shares the ARNs and accessor package
# FRIEND_AWS_ACCOUNT_ID=
# FRIEND_DYNAMO_REGION=us-west-2
# FRIEND_CROSS_ACCOUNT_ROLE_ARN=arn:aws:iam::<friend-account>:role/<role-name>

# ── Bedrock (LLM) ──────────────────────────────────────────
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ── OpenSearch Serverless ──────────────────────────────────
# Deployed via LemonOpenSearchStack
OPENSEARCH_ENDPOINT=https://9tekwdal9w5pd4utjhw0.us-east-1.aoss.amazonaws.com
OPENSEARCH_COLLECTION_NAME=lemon-activity
OPENSEARCH_INDEX=activity-embeddings

# ── API Gateway ────────────────────────────────────────────
# Deployed via LemonApiGatewayStack
API_GATEWAY_URL=https://rh2nliwhb5.execute-api.us-east-1.amazonaws.com

# ── EC2 ────────────────────────────────────────────────────
EC2_INSTANCE_ID=i-0c98f7b176b6725e3
EC2_PUBLIC_IP=44.215.104.49
EC2_PUBLIC_DNS=ec2-44-215-104-49.compute-1.amazonaws.com
EC2_ROLE_ARN=arn:aws:iam::375243950000:role/LemonEc2Stack-LemonEc2Role73907989-ft7jxZb9HDMb

# ── Security ───────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
